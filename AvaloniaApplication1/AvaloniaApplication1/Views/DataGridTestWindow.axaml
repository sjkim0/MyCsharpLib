<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:AvaloniaApplication1.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="AvaloniaApplication1.DataGridTestWindow"
        x:DataType="vm:DataGridTestWindowViewModel"
        Title="DataGridTestWindow">
  <Design.DataContext>
    <vm:DataGridTestWindowViewModel></vm:DataGridTestWindowViewModel>
  </Design.DataContext>
  <Grid>
    <DataGrid ItemsSource="{Binding My_item}"
              AutoGenerateColumns="{Binding Auto_gen_column}">
    </DataGrid>
  </Grid>
</Window>
